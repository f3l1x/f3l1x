# Cloudflare Pages: https://developers.cloudflare.com/pages/configuration/headers/
# HSTS is deliberately not set here: enable it in the Cloudflare dashboard (SSL/TLS > Edge Certificates > HSTS).

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://slides.com https://docs.google.com https://prezi.com https://nowdoc.github.io; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/llms.txt
  Cache-Control: public, max-age=3600
/llms-full.txt
  Cache-Control: public, max-age=3600
/rss.xml
  Cache-Control: public, max-age=3600
