<dialog id="ui-lightbox" aria-label="Image viewer">
  <div class="lb-count" aria-live="polite"></div>
  <button type="button" class="lb-close" aria-label="Close">×</button>
  <button type="button" class="lb-nav lb-prev" aria-label="Previous image">‹</button>
  <figure>
    <img alt="" src="data:image/gif;base64,R0lGODlhAQABAAAAACwAAAAAAQABAAACAkQBADs=" />
    <figcaption></figcaption>
  </figure>
  <button type="button" class="lb-nav lb-next" aria-label="Next image">›</button>
</dialog>

<script>
  const dlg = document.getElementById('ui-lightbox') as HTMLDialogElement | null
  // Only images from the Markdown body: not the avatars, covers or talk thumbnails around it.
  const body = document.querySelector('article .entry-body')
  if (dlg && body) {
    const view = dlg.querySelector('img')!
    const BLANK = view.src
    const cap = dlg.querySelector('figcaption')!
    const count = dlg.querySelector('.lb-count') as HTMLElement
    const prev = dlg.querySelector('.lb-prev') as HTMLElement
    const next = dlg.querySelector('.lb-next') as HTMLElement
    // Skip linked images and small ones (icons, badges) where zooming shows nothing new.
    const imgs = [...body.querySelectorAll('img')].filter((i) => !i.closest('a') && !(Number(i.getAttribute('width')) < 400)) as HTMLImageElement[]
    let idx = 0

    const show = (i: number) => {
      idx = (i + imgs.length) % imgs.length
      const src = imgs[idx]
      view.src = src.currentSrc || src.src
      view.alt = src.alt
      cap.textContent = src.alt && src.alt !== 'image' ? src.alt : ''
      const many = imgs.length > 1
      prev.hidden = next.hidden = !many
      count.textContent = many ? `${idx + 1} / ${imgs.length}` : ''
      // warm the neighbours
      for (const n of [idx - 1, idx + 1]) new Image().src = imgs[(n + imgs.length) % imgs.length].src
    }

    imgs.forEach((img, i) => {
      img.classList.add('zoomable')
      img.addEventListener('click', () => { show(i); dlg.showModal(); document.documentElement.style.overflow = 'hidden' })
    })
    prev.addEventListener('click', () => show(idx - 1))
    next.addEventListener('click', () => show(idx + 1))
    dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close())
    dlg.addEventListener('click', (e) => { if (e.target === dlg || (e.target as HTMLElement).tagName === 'FIGURE') dlg.close() })
    dlg.addEventListener('close', () => { document.documentElement.style.overflow = ''; view.src = BLANK })
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(idx - 1)
      else if (e.key === 'ArrowRight') show(idx + 1)
    })
    // swipe
    let x0 = 0
    dlg.addEventListener('pointerdown', (e) => { x0 = e.clientX })
    dlg.addEventListener('pointerup', (e) => {
      const dx = e.clientX - x0
      if (Math.abs(dx) > 60) show(idx + (dx < 0 ? 1 : -1))
    })
  }
</script>
