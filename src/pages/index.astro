---
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import { thumbnail } from '../lib/thumb'
import { websiteLd } from '../lib/seo'
import { newestFirst } from '../lib/content'

const posts = await Promise.all((await getCollection('blog')).sort(newestFirst).map(async (e) => ({ e, img: await thumbnail(e) })))
const featured = posts.filter((p) => p.img).slice(0, 4)
const more = posts.filter((p) => !featured.includes(p)).slice(0, 5).map((p) => p.e)
const talks = (await getCollection('talks')).filter((t) => t.data.cover).sort(newestFirst).slice(0, 3)
const ym = (d?: Date) => d?.toISOString().slice(0, 7)
---
<Base title="f3l1x" jsonld={websiteLd} description="Milan Šulc, better known as Felix. I do code for a living: PHP, Docker, TypeScript, open source and Nette.">
  <section class="hero">
    <h1 class="lead">Hey, I'm <strong>Milan Šulc</strong>, better known as Felix.</h1>
    <p>I do code for a living. Open source, PHP, Docker, TypeScript, and whatever I'm tinkering with.</p>
    <p class="hero-links"><a href="/about">About me</a><a href="/oss">Open source</a><a href="https://github.com/f3l1x">GitHub</a></p>
  </section>

  <h2 class="section">Latest posts</h2>
  <ul class="cards">
    {featured.map(({ e, img }) => (
      <li>
        <a href={`/blog/${e.id}`}>
          <Image src={img!} alt="" widths={[320, 640]} sizes="(max-width: 40rem) 100vw, 19rem" loading="eager" />
          <span>{e.data.title}</span>
          <small>{ym(e.data.date)}</small>
        </a>
      </li>
    ))}
  </ul>
  <ul class="list" style="margin-top:1rem">
    {more.map((e) => <li><time>{e.data.date?.toISOString().slice(0, 10)}</time><a href={`/blog/${e.id}`}>{e.data.title}</a></li>)}
  </ul>
  <a class="more" href="/blog">All posts →</a>

  <h2 class="section">Recent talks</h2>
  <ul class="cards cards-3">
    {talks.map((e) => (
      <li>
        <a href={`/talks/${e.id}`}>
          <Image src={e.data.cover!} alt="" widths={[240, 480]} sizes="(max-width: 40rem) 100vw, 12rem" loading="lazy" />
          <span>{e.data.title}</span>
          <small>{ym(e.data.date)}</small>
        </a>
      </li>
    ))}
  </ul>
  <a class="more" href="/talks">All talks →</a>
</Base>
