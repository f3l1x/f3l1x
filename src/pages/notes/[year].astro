---
import { getCollection } from 'astro:content'
import List from '../../layouts/List.astro'
export async function getStaticPaths() {
  const all = await getCollection('notes')
  const years = [...new Set(all.map((e) => e.id.split('/')[0]))].filter((y) => /^\d{4}$/.test(y))
  return years.map((year) => ({
    params: { year },
    props: { items: all.filter((e) => e.id.startsWith(year + '/')).sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0)) },
  }))
}
const { year } = Astro.params
const { items } = Astro.props
---
<List title={`Notes ${year}`} items={items} base="/notes" />
