---
import { clip, SITE, SITE_NAME, SITE_TAGLINE, TWITTER } from '../lib/seo'
import { usableDescription } from '../lib/content'
import Search from '../components/Search.astro'
interface Props {
  title: string
  description?: string
  image?: string
  type?: 'website' | 'article'
  published?: Date
  tags?: string[]
  noindex?: boolean
  lang?: 'en' | 'cs'
  jsonld?: object | object[]
}
const { title, description, image, type = 'website', published, tags = [], noindex = false, lang = 'en', jsonld } = Astro.props
const nav = [['Blog', '/blog'], ['Talks', '/talks'], ['Wiki', '/wiki'], ['Notes', '/notes'], ['About', '/about']]
const path = Astro.url.pathname.replace(/(.)\/$/, '$1')
const url = new URL(path, Astro.site).href
const fullTitle = title === SITE_NAME ? SITE_NAME : `${title} · ${SITE_NAME}`
const desc = clip(usableDescription(description) ?? SITE_TAGLINE)
const ogImage = new URL(image ?? '/og/default.png', Astro.site).href
const ogLocale = lang === 'cs' ? 'cs_CZ' : 'en_US'
const ld = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : []
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="author" content="Milan Šulc" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <link rel="canonical" href={url} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    {type === 'article' && published && <meta property="article:published_time" content={published.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={`${SITE}/about`} />}
    {type === 'article' && tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={TWITTER} />
    <meta name="twitter:creator" content={TWITTER} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    {ld.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(ld.length === 1 ? ld[0] : { '@context': 'https://schema.org', '@graph': ld })} />}
    <script is:inline>
      try { var t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t } catch (e) {}
    </script>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#fdfdfc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121214" media="(prefers-color-scheme: dark)" />
    <link rel="alternate" type="application/rss+xml" title="f3l1x" href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
  </head>
  <body>
    <header>
      <a class="brand" href="/">f3l1x</a>
      <nav aria-label="Main">
        {nav.map(([label, href]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}
        <button type="button" class="icon-btn" data-search-open aria-label="Search" title="Search (/)">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </button>
        <button type="button" id="ui-theme" class="icon-btn theme" aria-label="Theme: system" title="Theme: system">
          <svg class="i-system" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
          <svg class="i-light" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="i-dark" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
      </nav>
    </header>
    <main><slot /></main>
    <Search />
    <footer>
      <span>© {new Date().getFullYear()} Milan Šulc</span>
      <span><a href="https://github.com/f3l1x">GitHub</a> · <a href="https://twitter.com/xf3l1x">X</a></span>
    </footer>
    <script is:inline>
      (function () {
        var btn = document.getElementById('ui-theme'), root = document.documentElement, order = ['system', 'light', 'dark'];
        function current() { var t = root.dataset.theme; return t === 'light' || t === 'dark' ? t : 'system' }
        function paint() {
          var t = current(); btn.dataset.mode = t;
          btn.setAttribute('aria-label', 'Theme: ' + t); btn.title = 'Theme: ' + t + ' (click to change)';
        }
        btn.addEventListener('click', function () {
          var next = order[(order.indexOf(current()) + 1) % 3];
          if (next === 'system') { delete root.dataset.theme } else { root.dataset.theme = next }
          try { next === 'system' ? localStorage.removeItem('theme') : localStorage.setItem('theme', next) } catch (e) {}
          paint();
        });
        paint();
      })();
    </script>
  </body>
</html>
<style is:global>
  :root {
    color-scheme: light;
    --fg: #18181b; --bg: #fdfdfc; --muted: #71717a; --line: #e7e7e4; --accent: #2f5fd0; --code: #f3f4f6; --code-line: #dfe2e7;
    --measure: 40rem;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) { color-scheme: dark; --fg: #e6e6e3; --bg: #121214; --muted: #8e8e96; --line: #26262a; --accent: #8fb0ff; --code: #16181d; --code-line: #2b2e36; }
  }
  :root[data-theme='dark'] { color-scheme: dark; --fg: #e6e6e3; --bg: #121214; --muted: #8e8e96; --line: #26262a; --accent: #8fb0ff; --code: #16181d; --code-line: #2b2e36 }
  :root[data-theme='light'] { color-scheme: light }
  * { box-sizing: border-box }
  [hidden] { display: none !important }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth }
  body {
    margin: 0; background: var(--bg); color: var(--fg); padding-inline: 1.25rem;
    font: 1.0625rem/1.7 ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
  }
  header, main, footer { max-width: var(--measure); margin-inline: auto }
  header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .5rem 1.5rem; padding-block: 2rem 1rem }
  .brand { font-weight: 700; letter-spacing: -.02em; font-size: 1.15rem; color: var(--fg); text-decoration: none }
  nav { display: flex; gap: 1.25rem; font-size: .95rem }
  nav a { color: var(--muted); text-decoration: none; padding-block: .15rem; border-bottom: 1px solid transparent }
  .icon-btn { display: inline-flex; align-items: center; background: none; border: 0; padding: .15rem; margin: 0; color: var(--muted); cursor: pointer; border-radius: 4px; align-self: center }
  .icon-btn:hover { color: var(--fg) }
  .icon-btn svg { display: block }
  #ui-search { border: 1px solid var(--line); border-radius: 12px; background: var(--bg); color: var(--fg); padding: 0; width: min(38rem, calc(100vw - 2rem)); max-height: min(34rem, 80dvh); margin: 12vh auto auto; overflow: hidden }
  #ui-search[open] { display: flex; flex-direction: column }
  #ui-search::backdrop { background: rgba(8, 8, 10, .45) }
  .s-box { display: flex; align-items: center; gap: .65rem; padding: .85rem 1rem; border-bottom: 1px solid var(--line); color: var(--muted); margin: 0 }
  .s-box input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--fg); font: inherit; font-size: 1.05rem; -webkit-appearance: none; appearance: none }
  .s-box input::-webkit-search-cancel-button { display: none }
  #ui-search kbd { font: .72rem/1 ui-monospace, SFMono-Regular, Menlo, monospace; border: 1px solid var(--code-line); background: var(--code); border-radius: 5px; padding: .2rem .35rem; color: var(--muted) }
  #ui-search-results { list-style: none; margin: 0; padding: .35rem; overflow-y: auto }
  #ui-search-results li { margin: 0; border-radius: 8px }
  #ui-search-results li[aria-selected='true'] { background: var(--code) }
  #ui-search-results a { display: block; padding: .5rem .7rem; color: var(--fg); text-decoration: none }
  .s-title { display: block; font-weight: 600; line-height: 1.35 }
  .s-meta { display: block; color: var(--muted); font-size: .85rem; line-height: 1.4; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical }
  .s-meta b { font-weight: 600; color: var(--accent); margin-right: .25rem; font-size: .78rem; text-transform: uppercase; letter-spacing: .04em }
  .s-scope { flex: none; display: inline-flex; align-items: center; gap: .2rem; font: 600 .78rem/1 ui-sans-serif, system-ui, sans-serif; color: var(--accent); background: var(--code); border: 1px solid var(--code-line); border-radius: 6px; padding: .3rem .45rem; cursor: pointer; text-transform: uppercase; letter-spacing: .04em }
  .s-scope:hover { color: var(--fg) }
  .wiki-bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; font-size: .9rem }
  .wiki-back { color: var(--muted); text-decoration: none; white-space: nowrap }
  .wiki-back:hover { color: var(--fg) }
  .wiki-search { display: inline-flex; align-items: center; gap: .5rem; flex: 0 1 15rem; min-width: 0; font: inherit; color: var(--muted); background: none; border: 1px solid var(--line); border-radius: 8px; padding: .35rem .6rem; cursor: text; text-align: left }
  .wiki-search span { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap }
  .wiki-search:hover { border-color: var(--muted) }
  .wiki-search kbd { font: .72rem/1 ui-monospace, SFMono-Regular, Menlo, monospace; border: 1px solid var(--code-line); background: var(--code); border-radius: 5px; padding: .15rem .35rem }
  @media (hover: none) { .wiki-search kbd { display: none } }
  .s-hint { margin: 0; padding: .9rem 1rem; color: var(--muted); font-size: .9rem }
  .theme svg { display: none }
  .theme[data-mode='system'] .i-system, .theme[data-mode='light'] .i-light, .theme[data-mode='dark'] .i-dark { display: block }
  .theme:not([data-mode]) .i-system { display: block }
  nav a:hover { color: var(--fg) }
  nav a[aria-current] { color: var(--fg); border-bottom-color: var(--fg) }
  main { padding-block: 2.5rem 5rem }
  footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem; padding-block: 1.5rem 3rem; color: var(--muted); font-size: .875rem }
  a { color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: .2em; text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent) }
  a:hover { text-decoration-color: currentColor }
  footer a { color: inherit }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 2px }

  h1, h2, h3, h4, h5, h6 { line-height: 1.25; letter-spacing: -.015em; font-weight: 650 }
  h1 { font-size: 2rem; margin: 0 0 .5rem; letter-spacing: -.025em }
  h2 { font-size: 1.4rem; margin: 2.5rem 0 .5rem }
  h3 { font-size: 1.15rem; margin: 2rem 0 .4rem }
  h4, h5, h6 { font-size: 1rem; margin: 1.5rem 0 .3rem }
  p, ul, ol, pre, table, blockquote, figure { margin-block: 0 1.1rem }
  li { margin-block: .2rem }
  hr { border: 0; border-top: 1px solid var(--line); margin-block: 2.5rem }
  img, video, iframe { max-width: 100%; height: auto; border-radius: 8px }
  pre { overflow-x: auto; padding: 1.05rem 1.2rem; background: var(--code); border: 1px solid var(--code-line); border-radius: 10px; font-size: .86rem; line-height: 1.6; tab-size: 2 }
  .astro-code, .astro-code span { color: var(--shiki-light) }
  @media (prefers-color-scheme: dark) { :root:not([data-theme='light']) .astro-code, :root:not([data-theme='light']) .astro-code span { color: var(--shiki-dark) } }
  :root[data-theme='dark'] .astro-code, :root[data-theme='dark'] .astro-code span { color: var(--shiki-dark) }
  code { font: .88em ui-monospace, SFMono-Regular, Menlo, monospace }
  :not(pre) > code { background: var(--code); border: 1px solid var(--code-line); padding: .08em .35em; border-radius: 5px; font-size: .86em }
  table { display: block; overflow-x: auto; border-collapse: collapse; font-size: .95rem }
  th, td { border-bottom: 1px solid var(--line); padding: .4rem .8rem .4rem 0; text-align: left }
  blockquote { margin-inline: 0; padding: .75rem 1.1rem; background: var(--code); border-radius: 8px; color: inherit }
  blockquote > :last-child { margin-bottom: 0 } blockquote p:first-child { margin-top: 0 }
  .embed { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; margin-bottom: 1.5rem; background: var(--code) }
  details { margin-block: 0 1.1rem } summary { cursor: pointer }
  main { overflow-wrap: anywhere }

  .meta { display: flex; flex-wrap: wrap; gap: .25rem 1rem; color: var(--muted); font-size: .9rem; margin-bottom: 2.25rem }
  .meta .tags a, .meta .tags span { color: var(--muted); text-decoration: none }
  .meta .tags span::before { content: '#' }
  .meta .updated time { color: var(--fg) }
  .meta .updated time[title] { cursor: help; text-decoration: underline dotted color-mix(in srgb, var(--muted) 60%, transparent); text-underline-offset: .25em }
  .talk-head { display: grid; grid-template-columns: 11rem 1fr; gap: 1.5rem; align-items: start; margin-bottom: 1rem }
  .talk-head:not(:has(.talk-cover)) { grid-template-columns: 1fr }
  .talk-head .meta { margin-bottom: 1rem }
  .talk-head .links { margin-bottom: 0 }
  .talk-cover { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: var(--code); border: 1px solid var(--line) }
  @media (max-width: 30rem) { .talk-head { grid-template-columns: 6.5rem 1fr; gap: 1rem } .talk-head h1 { font-size: 1.5rem } }
  .cover { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; margin-bottom: 1.5rem; background: var(--code) }
  img.zoomable { cursor: zoom-in }
  .entry-body { display: contents }
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: .5rem }
  .gallery img { width: 100%; height: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 6px }
  #ui-lightbox { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100dvh; width: 100vw; height: 100dvh; color: #fff }
  #ui-lightbox::backdrop { background: rgba(8, 8, 10, .96) }
  #ui-lightbox[open] { display: grid; grid-template-columns: 4rem 1fr 4rem; align-items: center }
  #ui-lightbox figure { margin: 0; grid-column: 2; display: flex; flex-direction: column; align-items: center; justify-content: center; max-height: 100dvh; padding-block: 1rem; cursor: zoom-out }
  #ui-lightbox img { max-width: 100%; max-height: calc(100dvh - 4.5rem); width: auto; height: auto; object-fit: contain; border-radius: 4px; cursor: default }
  #ui-lightbox figcaption { margin-top: .6rem; font-size: .9rem; color: #c9c9ce; min-height: 1.2em; text-align: center }
  .lb-nav, .lb-close { background: none; border: 0; color: #fff; font-size: 2.5rem; line-height: 1; cursor: pointer; opacity: .75; padding: .5rem; height: 100%; }
  .lb-nav:hover, .lb-close:hover { opacity: 1 }
  .lb-prev { grid-column: 1; grid-row: 1 } .lb-next { grid-column: 3; grid-row: 1 }
  .lb-count { position: fixed; top: .9rem; left: 1rem; z-index: 2; font-size: .85rem; color: #c9c9ce; font-variant-numeric: tabular-nums }
  .lb-close { position: fixed; top: .5rem; right: .75rem; height: auto; z-index: 2; font-size: 2rem }
  @media (max-width: 40rem) { #ui-lightbox[open] { grid-template-columns: 2.5rem 1fr 2.5rem } .lb-nav { font-size: 2rem; padding-inline: 0 } }
  .codeblock { position: relative; margin-block: 0 1.1rem }
  .codeblock pre { margin: 0 }
  .code-bar { position: absolute; top: .45rem; right: .55rem; display: flex; align-items: center; gap: .5rem; font: .72rem/1 ui-monospace, SFMono-Regular, Menlo, monospace }
  .code-lang { color: var(--muted); text-transform: lowercase; letter-spacing: .02em; padding: .2rem .35rem; user-select: none }
  .code-copy { font: inherit; color: var(--muted); background: var(--bg); border: 1px solid var(--code-line); border-radius: 6px; padding: .3rem .55rem; cursor: pointer; opacity: 0; transition: opacity .12s }
  .codeblock:hover .code-copy, .code-copy:focus-visible { opacity: 1 }
  .code-copy:hover { color: var(--fg) }
  @media (hover: none) { .code-copy { opacity: 1 } }
  .links { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; margin-bottom: 2rem; font-size: .95rem }
  .lead { font-size: 1.5rem; line-height: 1.4; font-weight: 400; margin-block: 0 .75rem }
  .lead + p { color: var(--muted) }

  .filter { display: flex; align-items: center; gap: .6rem; margin-top: 1.5rem; padding: .55rem .85rem; border: 1px solid var(--line); border-radius: 10px; color: var(--muted) }
  .filter:focus-within { border-color: var(--accent) }
  .filter input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--fg); font: inherit; -webkit-appearance: none; appearance: none }
  .filter input::placeholder { color: var(--muted) }
  .filter-empty { color: var(--muted); margin-top: 1rem }
  .linklike { background: none; border: 0; padding: 0; font: inherit; color: var(--accent); cursor: pointer; text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent); text-underline-offset: .2em }
  ul.list { list-style: none; padding: 0; margin: 1.5rem 0 0 }
  ul.list li { display: grid; grid-template-columns: 6.5rem 1fr; gap: 0 1rem; padding-block: .4rem; margin: 0 }
  ul.list time { color: var(--muted); font-size: .9rem; font-variant-numeric: tabular-nums }
  ul.list a { color: var(--fg); text-decoration: none }
  ul.list a:hover { color: var(--accent) }
  ul.list.cols { columns: 2 14rem; column-gap: 2rem }
  ul.list.cols li { display: block; break-inside: avoid }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 1.75rem 1.25rem; list-style: none; padding: 0; margin: 2rem 0 0 }
  .cards li { margin: 0 }
  .cards a { color: var(--fg); text-decoration: none; display: block }
  .cards img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: var(--code); border: 1px solid var(--line); margin-bottom: .5rem; transition: opacity .15s }
  .cards a:hover img { opacity: .85 } .cards a:hover span { color: var(--accent) }
  .cards small { display: block; color: var(--muted); font-size: .8rem }
  .card-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem }
  .card-meta small { margin-right: .25rem }
  .badge { font-size: .72rem; line-height: 1; padding: .2rem .45rem; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); text-decoration: none; transition: color .15s, border-color .15s }
  .badge:hover, .badge:focus-visible { color: var(--accent); border-color: var(--accent) }
  .hero { margin-bottom: 3rem }
  .hero p { color: var(--muted); margin-bottom: .75rem }
  .hero .hero-links { display: flex; flex-wrap: wrap; gap: .4rem 1.25rem; font-size: .95rem; margin-top: 1rem }
  h2.section { font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 600; margin: 3rem 0 .25rem }
  .cards.cards-3 { grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr)); gap: 1.25rem .9rem }
  .more { display: inline-block; margin-top: 1rem; font-size: .95rem }
  @media (max-width: 30rem) {
    body { font-size: 1rem } h1 { font-size: 1.65rem }
    ul.list li { grid-template-columns: 1fr } ul.list time { font-size: .8rem }
  }
</style>
