---
import { render } from 'astro:content'
import { Image, getImage } from 'astro:assets'
import Base from './Base.astro'
import Lightbox from '../components/Lightbox.astro'
import Persona from '../components/Persona.astro'
import CodeBlocks from '../components/CodeBlocks.astro'
import { SITE, breadcrumbLd, detectLang } from '../lib/seo'
import { entryUrl, usableDescription } from '../lib/content'
import { slidesEmbed as toSlidesEmbed, videoEmbed as toVideoEmbed } from '../lib/embed'
const { entry } = Astro.props
const { Content } = await render(entry)
const d = entry.data
const section: string = entry.collection
const isArticle = section === 'blog' || section === 'notes'
const isWiki = section === 'wiki'
const isTalk = section === 'talks'
const urlPath = entryUrl(section, entry.id)
const url = `${SITE}${urlPath}`
const lang = detectLang(`${d.title}\n${entry.body ?? ''}`)
const og = d.cover
  ? (await getImage({ src: d.cover, width: 1200, height: 630, format: 'jpeg', fit: 'cover' })).src
  : `/og${urlPath}.png`
const summary = usableDescription(d.description)
const description = summary ?? (entry.body ?? '').replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1').replace(/[#>*`|_-]+/g, ' ').trim()
const date = d.date?.toISOString().slice(0, 10)
const updated = d.updated?.toISOString().slice(0, 10)
const published = d.date?.toISOString()
const modified = (d.updated ?? d.date)?.toISOString()
const me = { '@id': `${SITE}/#person` }

const crumbs = [{ name: 'Home', path: '/' }, ...(section === 'pages' ? [] : [{ name: section[0].toUpperCase() + section.slice(1), path: `/${section}` }]), { name: d.title, path: urlPath }]
const ld: any[] = [breadcrumbLd(crumbs)]
if (isArticle) ld.push({ '@type': 'BlogPosting', headline: d.title, description: summary, datePublished: published, dateModified: modified, url, mainEntityOfPage: url, inLanguage: lang, keywords: d.tags?.join(', '), author: me, publisher: me })
else if (isTalk) ld.push({ '@type': 'CreativeWork', name: d.title, description: summary, datePublished: published, url, inLanguage: lang, creator: me, ...(d.video ? { video: { '@type': 'VideoObject', name: d.title, url: d.video, uploadDate: published, thumbnailUrl: `${SITE}${og}` } } : {}) })
else ld.push({ '@type': 'WebPage', name: d.title, description: summary, url, inLanguage: lang, datePublished: published, dateModified: modified })

// Wiki pages are living documents: show only when they were last touched.
const human = (x: Date) => x.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
const lastTouched: Date | undefined = isWiki ? (d.updated ?? d.date) : undefined

// Talk-only fields
const videoEmbed = toVideoEmbed(d.video)
const slidesEmbed = toSlidesEmbed(d.slides)
const links = [['Slides', d.slides], ['GitHub', d.github], ['Video', videoEmbed ? null : d.video], ['Meetup', d.meetup]].filter(([, u]) => u)
const event = d.event && !/^https?:/.test(d.event) ? d.event : undefined
---
<Base title={d.title} description={description} image={og} type={isArticle ? 'article' : 'website'} published={d.date} tags={d.tags} lang={lang} jsonld={ld}>
  <article>
    {isWiki && (
      <div class="wiki-bar">
        <a href="/wiki" class="wiki-back">← Wiki</a>
        <button type="button" class="wiki-search" data-search-open data-search-scope="wiki" aria-label="Search the wiki">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <span>Search the wiki…</span>
          <kbd>/</kbd>
        </button>
      </div>
    )}
    {entry.id === 'about' && <Persona />}
    {isTalk ? <>
      <header class="talk-head">
        {d.cover && <Image class="talk-cover" src={d.cover} alt="" widths={[240, 480]} sizes="11rem" loading="eager" />}
        <div>
          <h1>{d.title}</h1>
          <div class="meta">
            {date && <time datetime={date}>{date}</time>}
            {event && <span>{event}</span>}
          </div>
          {links.length > 0 && <div class="links">{links.map(([l, u]) => <a href={u} rel="noopener">{l} ↗</a>)}</div>}
        </div>
      </header>
      {videoEmbed && <h2 id="video">Video</h2>}
      {videoEmbed && <iframe class="embed" src={videoEmbed} title={`${d.title} (video)`} loading="lazy" allow="accelerometer; encrypted-media; picture-in-picture; fullscreen" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>}
      {slidesEmbed && <h2 id="slides">Slides</h2>}
      {slidesEmbed && <iframe class="embed" src={slidesEmbed} title={`${d.title} (slides)`} loading="lazy" allowfullscreen></iframe>}
    </> : <>
    <h1>{d.title}</h1>
    <div class="meta">
      {isWiki
        ? lastTouched && <span class="updated">Last updated <time datetime={lastTouched.toISOString().slice(0, 10)} title={d.date ? `Created ${human(d.date)}` : undefined} data-ago>{human(lastTouched)}</time></span>
        : <>
            {date && <time datetime={date}>{date}</time>}
            {updated && updated !== date && <span>Updated <time datetime={updated}>{updated}</time></span>}
          </>}
      {d.tags?.length ? <span class="tags">{d.tags.map((t: string) => <span>{t} </span>)}</span> : null}
    </div>
    {d.cover && <Image class="cover" src={d.cover} alt="" widths={[640, 1280]} sizes="(max-width: 40rem) 100vw, 40rem" loading="eager" />}
    </>}
    <div class="entry-body"><Content /></div>
  </article>
  {isWiki && (
    <script is:inline>
      // Enhance the absolute date with a relative age ("· 6 months ago"); the date itself works without JS.
      document.querySelectorAll('time[data-ago]').forEach(function (t) {
        var days = (Date.now() - new Date(t.dateTime).getTime()) / 864e5
        if (!(days >= 0) || !window.Intl || !Intl.RelativeTimeFormat) return
        var rtf = new Intl.RelativeTimeFormat('en', { numeric: 'always' })
        var s = days < 1 ? 'today' : days < 31 ? rtf.format(-Math.round(days), 'day') : days < 730 ? rtf.format(-Math.round(days / 30.44), 'month') : rtf.format(-Math.floor(days / 365.25), 'year')
        var el = document.createElement('span')
        el.className = 'ago'
        el.textContent = ' · ' + s
        t.after(el)
      })
    </script>
  )}
  <Lightbox />
  <CodeBlocks />
</Base>
